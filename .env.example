# Sunucu
PORT=3000
# `npm start` bu değeri yok sayar ve HER ZAMAN production modunda başlatır
# (scripts/start.mjs). Geliştirme için `npm run dev` kullanın (NODE_ENV=development).
NODE_ENV=development

# Dinlenecek ağ arayüzü.
# 127.0.0.1 → yalnızca bu bilgisayar (varsayılan ve önerilen).
# 0.0.0.0   → yerel ağdaki tüm cihazlar (oturum açmadan veriye erişilemez,
#             ancak yalnızca güvenilir bir ağda kullanın).
HOST=127.0.0.1

# Ters vekil sunucu (nginx vb.) arkasında doğru istemci IP'si için.
# Boş/ kapalı (varsayılan, doğrudan bağlantı). Değerler:
#   1        → yalnızca ilk vekil atlamasına güven (önerilen)
#   true     → tüm vekillere güven (yalnız tek vekil arkasında)
#   loopback → loopback adreslerinden gelen X-Forwarded-For'a güven
# Doğru IP; giriş rate-limit'i ve denetim izi (audit) kayıtları için kritiktir.
TRUST_PROXY=

# MySQL veritabanı bağlantısı
DB_HOST=localhost
DB_PORT=3306
DB_USER=proerp
DB_PASSWORD=degistir
DB_NAME=proerp

# Oturum ömrü (saat). Süre dolduğunda kullanıcı yeniden giriş yapar.
SESSION_TTL_HOURS=24

# İlk kurulumda tüm demo kullanıcılara verilecek ortak parola.
# Boş bırakılırsa her kullanıcıya rastgele bir parola üretilir ve
# yalnızca bir kez sunucu konsoluna yazılır.
SEED_USER_PASSWORD=

# Üretim ortamında yıkıcı işlemler (demo verisine sıfırlama) varsayılan
# olarak kapalıdır. Açmak için true yapın.
ALLOW_DESTRUCTIVE_OPS=false

# Üretimde HTTPS arkasında çalışırken oturum çerezinin Secure bayrağını
# kapatmak gerekirse false yapın (önerilmez).
COOKIE_SECURE=true

# Yüklenen görsellerin (#51) yazılacağı dizin. Göreli yol proje köküne göre
# çözülür. Varsayılan: data/uploads
# ÖNEMLİ: Bu dizin deploy'da KALICI olmalı (container yeniden yaratıldığında
# kaybolmamalı) ve veritabanıyla birlikte YEDEKLENMELİDİR. Ürün/renk görselleri
# ve firma logosu artık DB'de değil burada dosya olarak tutulur; DB'de yalnızca
# /uploads/<hash>.<ext> URL'i saklanır.
UPLOAD_DIR=data/uploads

# Yedekleme/geri yükleme araçları (#55). mysqldump/mysql PATH'te değilse tam
# yolu verin (Windows'ta yaygın MySQL kurulum dizinleri otomatik aranır).
# Parola asla argv'ye yazılmaz; MYSQL_PWD env ile geçirilir (DB_PASSWORD kullanılır).
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
# MYSQL_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe

