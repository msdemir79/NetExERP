{
  "name": "proerp",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "electron:dev": "node scripts/electron-dev.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "electron:build": "node scripts/build-desktop.mjs && electron-builder --win --x64",
    "dist": "node scripts/build-desktop.mjs && electron-builder --win --x64",
    "release": "node scripts/release.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:columns": "node scripts/gen-columns.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "migrate:images": "tsx scripts/migrate-images-to-files.mts",
    "seed:accounts": "tsx scripts/seed-accounts.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "user:password": "tsx scripts/set-password.ts",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/unitTests.ts",
    "test:integration": "tsx src/tests/integrationTests.ts",
    "test:rbac": "tsx src/tests/rbacTests.ts",
    "test:colors": "tsx src/tests/colorTests.ts",
    "test:load": "tsx src/tests/loadTest.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.4.3",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
